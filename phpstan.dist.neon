includes:
  - ./vendor/phpstan/phpstan/conf/bleedingEdge.neon
  - phpstan-baseline.neon

parameters:
  paths:
    - src
    - config
  excludePaths:
    - assets/*
    - docker/*
    - node_modules/*
    - tests/*
  level: 6 # (0-8)
  parallel:
  	maximumNumberOfProcesses: 4
  ignoreErrors:
    -
       identifier: missingType.generics
