# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

APP_NAME=MeraShop

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
POSTGRES_HOST=pgsql
FORWARD_DB_PORT=5532
FORWARD_TEST_DB_PORT=5422
POSTGRES_DB_CUSTOMER=merashop_customer
POSTGRES_DB_IDENTITY_ACCESS=merashop_identity_access
POSTGRES_DB_EMAIL_SENDER=merashop_email_sender
POSTGRES_DB_CATALOG=merashop_catalog
POSTGRES_USER=merashop_u
POSTGRES_PASSWORD=merashop_p
POSTGRES_VERSION=18
BASE_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/"
BASE_DATABASE_URL_QUERY="?serverVersion=${POSTGRES_VERSION}&charset=utf8"
DATABASE_URL_CATALOG="${BASE_DATABASE_URL}${POSTGRES_DB_CATALOG}${BASE_DATABASE_URL_QUERY}"
DATABASE_URL_CUSTOMER="${BASE_DATABASE_URL}${POSTGRES_DB_CUSTOMER}${BASE_DATABASE_URL_QUERY}"
DATABASE_URL_EMAIL_SENDER="${BASE_DATABASE_URL}${POSTGRES_DB_EMAIL_SENDER}${BASE_DATABASE_URL_QUERY}"
DATABASE_URL_IDENTITY_ACCESS="${BASE_DATABASE_URL}${POSTGRES_DB_IDENTITY_ACCESS}${BASE_DATABASE_URL_QUERY}"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
DOCTRINE_MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

RABBITMQ_DEFAULT_USER=merashop_rmq_u
RABBITMQ_DEFAULT_PASS=merashop_rmq_p
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_FORWARD_PORT=5672
RABBITMQ_DASHBOARD_FORWARD_PORT=15672
RABBITMQ_QUEUE=messages
AMQP_MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/%2f/${RABBITMQ_QUEUE}"
###< symfony/messenger ###

###> symfony/mailer ###
# MAILER_DSN=null://null
###< symfony/mailer ###

EMAIL_OUTBOX_MAX_ATTEMPTS=5

###> symfony/google-mailer ###
# Gmail SHOULD NOT be used on production, use it in development only.
# MAILER_DSN=gmail://USERNAME:PASSWORD@default
###< symfony/google-mailer ###

APP_RUNTIME_ENV=local
PHP_CGI_PASS=app

APP_WEB_DOMAIN=merashop.test
APP_API_DOMAIN=api.merashop.test
APP_ADMIN_API_DOMAIN=admin-api.merashop.test
APP_SOURCES_DOMAIN=sources.merashop.test

###> monolog ###
MONOLOG_FORMATTER=monolog.formatter.line
###< monolog ###

ELASTIC_XPACK_SECURITY_ENABLED=false
ELASTIC_HOSTS="http://elasticsearch:9200"
ELASTIC_FORWARD_PORT=9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme

KIBANA_ELASTIC_HOST="${ELASTIC_HOSTS}"
KIBANA_FOWARD_PORT=5601
KIBANA_HOST="http://kibana:5601"
KIBANA_USERNAME=kibana
KIBANA_PASSWORD=changeme

###> league/oauth2-server ###
JWT_TTL="3600" # seconds
REFRESH_TOKEN_TTL="2592000" # in seconds 30 days
###< league/oauth2-server ###

###> symfony/cache ###
REDIS_HOST=redis
FORWARD_REDIS_PORT=6379
FORWARD_TEST_REDIS_PORT=63792
REDIS_URL="redis://${REDIS_HOST}:6379"
REDIS_URL_BLACKLIST="redis://${REDIS_HOST}:6379/1"
###< symfony/cache ###
