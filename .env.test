# define your env variables for the test env here
APP_ENV=test
APP_SECRET='$ecretf0rt3st'

KERNEL_CLASS='App\Shared\Infrastructure\Kernel'

POSTGRES_HOST=pgsql-test
BASE_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/"
DATABASE_URL_CATALOG="${BASE_DATABASE_URL}${POSTGRES_DB_CATALOG}${BASE_DATABASE_URL_QUERY}"
DATABASE_URL_CUSTOMER="${BASE_DATABASE_URL}${POSTGRES_DB_CUSTOMER}${BASE_DATABASE_URL_QUERY}"
DATABASE_URL_EMAIL_SENDER="${BASE_DATABASE_URL}${POSTGRES_DB_EMAIL_SENDER}${BASE_DATABASE_URL_QUERY}"
DATABASE_URL_IDENTITY_ACCESS="${BASE_DATABASE_URL}${POSTGRES_DB_IDENTITY_ACCESS}${BASE_DATABASE_URL_QUERY}"

REDIS_HOST=redis-test
REDIS_URL="redis://${REDIS_HOST}:6379"
REDIS_URL_BLACKLIST="redis://${REDIS_HOST}:6379/1"

MAIL_DRIVER=log

